{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["develop"],
  "timezone": "Europe/Brussels",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Our own modules are built here, not downloaded",
      "matchPackageNames": ["be.achzak:*"],
      "enabled": false
    },
    {
      "description": "Use the build commit type for Maven updates",
      "matchManagers": ["maven", "maven-wrapper"],
      "semanticCommitType": "build"
    },
    {
      "description": "Group minor and patch Maven updates, keep majors separate",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "maven non-major"
    },
    {
      "description": "Group GitHub Actions updates under the ci commit type",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "groupName": "github actions"
    },
    {
      "description": "PostgreSQL majors must match Testcontainers and Azure, so they are upgraded by hand",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "One pull request for the Azure API versions in the Bicep templates",
      "matchManagers": ["bicep"],
      "groupName": "azure api versions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Testcontainers images in the tests, so they move with compose.yaml",
      "managerFilePatterns": ["/src/test/java/.+\\.java$/"],
      "matchStrings": ["DockerImageName\\.parse\\(\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)\"\\)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Bicep CLI that ci.yaml installs",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["az bicep install --version v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "Azure/bicep",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
